{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aster",
  "version": "0.1.0-alpha.5",
  "identifier": "app.aster.editor",
  "build": {
    "beforeDevCommand": "pnpm -F @aster/ui dev",
    "beforeBuildCommand": "pnpm -F @aster/ui build",
    "frontendDist": "../../packages/ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Aster",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "label": "main",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' asset: http://asset.localhost; style-src 'self' 'unsafe-inline' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost https: data: blob:; font-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**",
          "$HOME/**",
          "/Volumes/**",
          "/tmp/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {
        "version": "0.1.0.4"
      }
    }
  }
}
