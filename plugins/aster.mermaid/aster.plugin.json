{
  "id": "aster.mermaid",
  "name": "Mermaid",
  "version": "1.1.0",
  "apiVersion": "1",
  "description": "Render ```mermaid diagrams",
  "permissions": [],
  "activation": [
    "onCodeBlock:mermaid"
  ],
  "frontend": "frontend/index.js",
  "backend": null,
  "contributes": {
    "renderers": [
      {
        "codeBlock": "mermaid"
      }
    ],
    "commands": [
      {
        "id": "mermaid.exportSvg",
        "description": "Export the focused Mermaid block to SVG",
        "params": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            }
          },
          "required": [
            "source"
          ]
        },
        "returns": {
          "type": "object",
          "properties": {
            "svg": {
              "type": "string"
            }
          }
        },
        "headless": false
      }
    ]
  },
  "i18n": {
    "zh": {
      "name": "Mermaid 图表",
      "description": "渲染 ```mermaid 图表"
    }
  }
}
