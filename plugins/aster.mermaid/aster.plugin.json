{
  "id": "aster.mermaid",
  "name": "Mermaid",
  "version": "1.0.0",
  "apiVersion": "1",
  "description": "Render Mermaid diagrams in live preview and reading mode",
  "permissions": [],
  "activation": ["onCodeBlock:mermaid"],
  "frontend": "frontend/index.js",
  "backend": null,
  "contributes": {
    "renderers": [{ "codeBlock": "mermaid" }],
    "commands": [{
      "id": "mermaid.exportSvg",
      "description": "Export the focused Mermaid block to SVG",
      "params": { "type": "object", "properties": { "source": { "type": "string" } }, "required": ["source"] },
      "returns": { "type": "object", "properties": { "svg": { "type": "string" } } },
      "headless": false
    }]
  }
}
